# URL del back-end (Spring Boot). Debe coincidir con server.port del back.
VITE_API_URL=http://localhost:8081

# true  = login y módulos con datos simulados (no necesita el back-end).
# false = todo contra el back-end real (login, registro y Google ya funcionan;
#         los módulos necesitan que el back exponga sus endpoints y los roles ADMIN, VENDEDOR, BODEGA, GERENTE, CONTADOR).
VITE_USE_MOCK=true
